# Environment Variables for Render / Production
SPRING_PROFILES_ACTIVE=prod
PORT=8082

# Cloud Database (Aiven MySQL / Render Postgres / MySQL)
DATASOURCE_URL=jdbc:mysql://<host>:<port>/<dbname>?ssl-mode=REQUIRED
DATASOURCE_USERNAME=<username>
DATASOURCE_PASSWORD=<password>
DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Security & JWT
JWT_SECRET=travel-app-jwt-secret-key-change-in-production-min-256-bits-long!!

# API Keys (Provide in Render Environment Settings)
WEATHER_API_KEY=your_weather_api_key
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GROK_API_KEY=your_grok_api_key
NEWS_API_KEY=your_news_api_key
DUFFEL_API_KEY=your_duffel_api_key
DUFFEL_CARS_API_KEY=your_duffel_cars_api_key
HOTELBEDS_API_KEY=your_hotelbeds_api_key
HOTELBEDS_API_SECRET=your_hotelbeds_api_secret
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
